{
  "buildCommand": "cd api && npm install && cd ../mobile && npm install --legacy-peer-deps && npx expo export -p web --output-dir dist",
  "outputDirectory": "mobile/dist",
  "framework": null,
  "functions": {
    "api/vercel.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/admin/users/:id", "destination": "/api/vercel" },
    { "source": "/admin/users", "destination": "/api/vercel" },
    { "source": "/api/vercel", "destination": "/api/vercel" },
    { "source": "/api/health", "destination": "/api/vercel" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
